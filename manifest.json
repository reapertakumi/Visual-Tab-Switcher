{
  "manifest_version": 3,
  "name": "Visual Tab Switcher: Tab Previews, Search & Bookmarks",
  "short_name": "Visual Tab Switcher",
  "version": "0.2.0",
  "description": "Press Alt+Q to switch tabs with live previews, F2 to search every open tab and F4 to browse bookmarks. All from the keyboard.",
  "permissions": [
    "tabs",
    "scripting",
    "storage",
    "bookmarks",
    "favicon"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "options_page": "settings.html",
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Visual Tab Switcher settings"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "toggle-tab-switcher": {
      "suggested_key": {
        "default": "Alt+Q"
      },
      "description": "Open the tab switcher / select next tab"
    },
    "toggle-tab-switcher-reverse": {
      "suggested_key": {
        "default": "Alt+Shift+Q"
      },
      "description": "Open the tab switcher / select previous tab"
    },
    "search-mode": {
      "description": "Search tabs in all windows"
    },
    "bookmarks-mode": {
      "description": "Search bookmarks"
    }
  },
  "web_accessible_resources": [
    {
      "resources": ["ui.js", "_favicon/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
